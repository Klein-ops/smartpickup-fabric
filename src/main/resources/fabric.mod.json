{
  "schemaVersion": 1,
  "id": "smartpickup",
  "version": "${version}",
  "name": "智能拾取",
  "description": "智能拾取——智能物品拾取模组：拾取优先进背包、自动补充、黑名单、拾取提示。",
  "license": "MIT",
  "authors": [
    "Klein-ops"
  ],
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.smartpickup.SmartPickupMod"
    ],
    "client": [
      "com.smartpickup.client.SmartPickupClient"
    ],
    "modmenu": [
      "com.smartpickup.client.ModMenuIntegration"
    ]
  },
  "mixins": [
    {
      "config": "smartpickup.mixins.json"
    }
  ],
  "depends": {
    "fabricloader": ">=1.0.0",
    "fabric-api": "*",
    "minecraft": ">=1.21.10- <1.21.11-",
    "java": ">=21"
  },
  "suggests": {
    "modmenu": "*"
  }
}